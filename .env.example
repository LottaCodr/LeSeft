# Create these in LeSeft-controlled accounts; never commit real secrets.
# Website/public settings
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DRAFT_MODE=true
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=
# For the separately hosted Sanity Studio; use the same project and dataset.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Only for private datasets; leave blank for a public dataset. Server-side only.
SANITY_API_READ_TOKEN=
# Only temporarily for optional `npm run seed`. Do not expose as NEXT_PUBLIC.
SANITY_API_WRITE_TOKEN=
# Enquiries: all settings below must be configured before the form accepts submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional, only after explicit approval: e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
